# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
webos-app
packages
# Packaged webOS build artifacts must never land in the repo root.
/*.ipk
*.local
.env
.env.*
!.env.example

# Agent tooling: keep the shareable settings, ignore machine-local overrides.
.claude/settings.local.json

# Recorded provider payloads can contain private catalog data and credentials.
fixtures/

# Cloudflare Worker secrets and local state
metadata-proxy/.dev.vars
metadata-proxy/.wrangler/
.wrangler/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.gstack/

# Superpowers/gstack planning artifacts are tooling output, not project docs.
docs/superpowers/

# Delegated-agent run logs and staged patches (local tooling output).
.claude/agent-runs/
*.patch

# Disposable agent worktrees.
.claude/worktrees/
