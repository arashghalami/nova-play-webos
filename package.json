{
  "name": "nova-play-webos",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && node scripts/check-webos-bundle.mjs && npm run build:library-probe-worker",
    "build:library-probe-worker": "vite build --config vite.worker.config.ts",
    "test": "vitest run",
    "test:proxy": "vitest run metadata-proxy/worker.test.ts",
    "preview": "vite preview",
    "proxy:dev": "wrangler dev --config metadata-proxy/wrangler.toml",
    "proxy:deploy": "wrangler deploy --config metadata-proxy/wrangler.toml",
    "package:webos": "npm run build && ares-package webos-app -o packages"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^2.1.9",
    "wrangler": "4.29.1"
  },
  "dependencies": {
    "dashjs": "^5.2.0",
    "hls.js": "^1.6.16",
    "mpegts.js": "^1.8.0"
  }
}
